<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SubjectSelectionActivity"
    android:background="@drawable/game_background">

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="157dp"
        android:layout_marginTop="92dp"
        android:layout_marginEnd="157dp"
        android:layout_marginBottom="620dp"
        android:fontFamily="@font/pixelify_sans"
        android:text="Pick Category ?"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/subjectLayout"
        android:layout_width="249dp"
        android:layout_height="134dp"
        android:layout_marginTop="110dp"

        android:layout_marginBottom="320dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/categoryTitle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:fontFamily="@font/pixelify_sans"
            android:text="Subjects"
            android:textAlignment="center"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbScience"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:fontFamily="@font/pixelify_sans"
                android:text="Science" />

            <RadioButton
                android:id="@+id/rbMovies"
                android:layout_width="match_parent"
                android:layout_height="37dp"
                android:fontFamily="@font/pixelify_sans"
                android:text="Movies" />

            <RadioButton
                android:id="@+id/rbVideoGames"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:fontFamily="@font/pixelify_sans"
                android:text="Video Games"
                android:textAlignment="viewStart" />


        </RadioGroup>
    </LinearLayout>

    <Button
        android:id="@+id/startButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="160dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="161dp"
        android:layout_marginBottom="68dp"
        android:fontFamily="@font/pixelify_sans"
        android:text="Start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subjectLayout"
        app:layout_constraintVertical_bias="1.0" />


</androidx.constraintlayout.widget.ConstraintLayout>