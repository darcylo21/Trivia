<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TriviaZone"
    android:background="@drawable/game_background">

    <TextView
        android:id="@+id/tvTriviaZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="176dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="176dp"
        android:layout_marginBottom="577dp"
        android:text="Trivia Zone"
        android:textAlignment="center"
        android:textSize="34sp"
        android:fontFamily="@font/pixelify_sans"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44" />

    <TextView
        android:id="@+id/tvQuestionNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:text="Question"
        android:textSize="24sp"
        android:fontFamily="@font/pixelify_sans"
        app:layout_constraintBottom_toTopOf="@+id/tvQuestionText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTriviaZone"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="244dp"
        android:layout_height="118dp"
        android:layout_marginStart="66dp"
        android:layout_marginEnd="66dp"
        android:layout_marginBottom="60dp"
        android:text="Question text"
        android:textSize="16sp"
        android:fontFamily="@font/pixelify_sans"
        app:layout_constraintBottom_toTopOf="@+id/rgQuestionOptions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.473"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestionNum" />

    <RadioGroup
        android:id="@+id/rgQuestionOptions"
        android:layout_width="212dp"
        android:layout_height="187dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestionText">

        <RadioButton
            android:id="@+id/rbOptionOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option one"
            android:textAlignment="viewStart"
            android:fontFamily="@font/pixelify_sans"/>

        <RadioButton
            android:id="@+id/rbOptionTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option two"
            android:fontFamily="@font/pixelify_sans"/>

        <RadioButton
            android:id="@+id/rbOptionThree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option three"
            android:fontFamily="@font/pixelify_sans"/>

        <RadioButton
            android:id="@+id/rbOptionFour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Option four"
            android:fontFamily="@font/pixelify_sans"/>

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>